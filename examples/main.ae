ind Prod {a : Sort u} {b : Sort v} : Sort (max u v) :=
| mk : a -> b -> Self
elim rec

def modus_ponens (ha : A) (h : A -> B) : B :=
    h ha

ind Exists {a : Sort u} {P : a -> Prop} : Prop :=
| intro (w : a) (h : P w) : Self P
elim rec

ind False : Prop :=
elim rec

ind Nat : Sort u :=
| zero : Self
| succ : Self -> Self
elim rec

ind Eq {a : Sort u} (x : a) : a -> Prop :=
| refl : Self x x
elim rec
